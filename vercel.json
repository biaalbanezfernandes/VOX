{
  "builds": [
    {
      "src": "vox.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "modelos/**",
          "vox_config.py"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "vox.py"
    }
  ]
}
